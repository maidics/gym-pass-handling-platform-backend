@using FitPass.Application.Common.EmailModels.GymMemberships
@using FitPass.Application.Common.Resources
@model GymMembershipStatusChangedEmailModel
@inject ILocalizer localizer

@{
    bool isBanned = Model.NewStatus == GymMembershipStatus.Banned; 
}

<!DOCTYPE html>
<html lang="@Model.Language">
<head>
    <meta charset="utf-8" />
    <title>@(isBanned 
        ?  @localizer.Get(nameof(SharedResource.GymMembershipStatusBannedEmailSubject), @Model.GymName)
        : @localizer.Get(nameof(SharedResource.GymMembershipStatusUnbannedEmailSubject), @Model.GymName))</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 14px; color: #333; }
        .status-banned { color: #b00020; font-weight: bold; }
        .status-unbanned { color: #2e7d32; font-weight: bold; }
    </style>
</head>
<body>
    <p>@localizer.Get(nameof(SharedResource.EmailGreeting), @Model.UserFirstName)</p>

    @if (isBanned)
    {
        <p class="status-banned">@localizer.Get(nameof(SharedResource.GymMembershipStatusBannedEmailBody1))</p>
        <p>@localizer.Get(nameof(SharedResource.GymMembershipStatusBannedEmailBody2), @Model.GymName)</p>
    }
    else
    {
        <p class="status-unbanned">@localizer.Get(nameof(SharedResource.GymMembershipStatusUnbannedEmailBody1))</p>
        <p>@localizer.Get(nameof(SharedResource.GymMembershipStatusUnbannedEmailBody2), @Model.GymName)</p>
    }

    <p>@localizer.Get(nameof(SharedResource.EmailFarewell))
        <br />
        @FitPass.Domain.Strings.CommonStrings.AppName
    </p>
</body>
</html>